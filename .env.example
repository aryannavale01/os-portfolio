# GROQ_API_KEY: Required for the "Ask AI" chat feature.
# Create a key at https://console.groq.com (never commit it).
# In production (Vercel / AI Studio), add it as an environment secret.
GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The canonical URL where this site is hosted.
# Used for self-referential links, Open Graph metadata, and the sitemap.
# Example: https://your-portfolio.vercel.app
APP_URL="http://localhost:3000"

# RESEND_API_KEY: Required for the contact form email feature.
# Create a key at https://resend.com/api-keys (never commit it).
# Free tier: 100 emails/day, 3000/month.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# RESEND_TO_EMAIL: Where contact form emails are delivered.
RESEND_TO_EMAIL="aryannavale99@gmail.com"

# RESEND_FROM_EMAIL: Sender address shown to recipients.
# Default uses Resend's sandbox (works immediately for testing).
# For production, verify a custom domain at resend.com/domains.
# RESEND_FROM_EMAIL="contact@yourdomain.com"
